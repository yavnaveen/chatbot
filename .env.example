# ==============================================================================
# Tunnel Excavation AI - Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Security: API Key Authentication (Required for public Cloudflare Tunnel exposure)
# Incoming requests must supply this key via 'X-API-Key' header
API_SECRET_KEY=replace-with-a-secure-random-key

# Cross-Origin Resource Sharing (CORS)
# Use '*' to allow any web client/Cloudflare tunnel origin, or comma-separated URLs
CORS_ORIGINS=*

# Rate Limiting (Max requests per minute per client IP on /chat)
RATE_LIMIT_PER_MINUTE=60

# Local LLM Service (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
